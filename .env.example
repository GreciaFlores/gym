DJANGO_SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Detrás de un proxy TLS (Render): true => confía en X-Forwarded-Proto (URLs https, CSRF).
DJANGO_BEHIND_PROXY=False
# Orígenes https permitidos para CSRF, separados por coma. Ej: https://gym.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Firma los códigos de check-in. Obligatoria si DJANGO_DEBUG=False.
CHECKIN_SECRET=cambiame-por-otro-secreto-largo-y-aleatorio
# Vacío = SQLite local. Para PostgreSQL:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/gym
DATABASE_URL=
TRAINER_NAME=Tu Entrenador
TRAINER_BIO=Entrenamiento personalizado. Reservá tu lugar en la clase que prefieras.
