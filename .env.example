DJANGO_SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vacío = SQLite local. Para PostgreSQL:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/gym
DATABASE_URL=
TRAINER_NAME=Tu Entrenador
TRAINER_BIO=Entrenamiento personalizado. Reservá tu lugar en la clase que prefieras.

# --- Producción (hosting) ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<clave larga y aleatoria>   # obligatoria con DEBUG=False
# DJANGO_ALLOWED_HOSTS=tu-dominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
# DJANGO_TIME_ZONE=America/Argentina/Buenos_Aires

# --- Recordatorios por correo (ver docs/recordatorios-por-correo.md) ---
# Sin EMAIL_HOST los correos se imprimen en la consola.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=contraseña-de-aplicacion
# DEFAULT_FROM_EMAIL=AppTrainer <tu-correo@gmail.com>
# APP_URL=https://tu-app.onrender.com
# RECORDATORIO_HORA=21
